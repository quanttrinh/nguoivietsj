---
// @boundary astro
import { localized as all } from "~/generated/client/all";
import SiteLayout from "~/layouts/shared/SiteLayout.astro";
import { useLocale, getLocalizedUrl } from "~/shared/i18n";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false }: Props = Astro.props;
const { locale } = useLocale(Astro.url);
const messages = all(locale);
---

<SiteLayout
  title={title}
  description={description}
  brand={messages.site.brand}
  brandSubtitle={messages.site.brandSubtitle}
  homeHref={getLocalizedUrl("/", locale)}
  skipHref="#main"
  skipLabel={messages.site.skipToContent}
  languageLabel={messages.site.language}
  builtBy={messages.site.builtBy}
  noindex={noindex}
>
  <Fragment slot="header-actions">
    <slot name="header-actions" />
  </Fragment>
  <slot />
</SiteLayout>
