---
// @boundary astro
import { useDictionary, useLocale } from "astro-intlayer";
import { PUBLIC_REPOSITORY_URL } from "astro:env/client";
import { getLocalizedUrl } from "intlayer";

import SiteLayout from "~/layouts/shared/SiteLayout.astro";
import siteContent from "~/layouts/site.content";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false }: Props = Astro.props;
const { locale } = useLocale();
const messages = useDictionary(siteContent, locale);
---

<SiteLayout
  title={title}
  description={description}
  brand={messages.brand.value}
  brandSubtitle={messages.brandSubtitle.value}
  homeHref={getLocalizedUrl("/", locale)}
  skipHref="#main"
  skipLabel={messages.skipToContent.value}
  adminLabel={messages.adminShortcut.value}
  languageLabel={messages.language.value}
  repositoryUrl={PUBLIC_REPOSITORY_URL}
  noindex={noindex}
>
  <Fragment slot="header-actions">
    <slot name="header-actions" />
  </Fragment>
  <slot />
</SiteLayout>
