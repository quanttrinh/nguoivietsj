---
import { css } from "styled-system/css";

interface Props {
  padding?: "md" | "lg";
  maxWidth?: "xl" | "2xl";
  class?: string;
}

const { padding = "md", maxWidth, class: className }: Props = Astro.props;

const styles = {
  panel: css({
    width: "full",
    borderRadius: "2xl",
    borderWidth: "thin",
    borderStyle: "solid",
    borderColor: "outlineVariant",
    backgroundColor: "surfaceContainerLowest",
    boxShadow: "lg",
  }),
  padding: {
    md: css({
      paddingInline: { base: "5", md: "8" },
      paddingBlock: { base: "5", md: "8" },
    }),
    lg: css({
      paddingInline: { base: "5", md: "10" },
      paddingBlock: { base: "6", md: "10" },
    }),
  },
  maxWidth: {
    xl: css({ maxWidth: "xl" }),
    "2xl": css({ maxWidth: "2xl" }),
  },
};
---

<div
  class:list={[
    styles.panel,
    styles.padding[padding],
    maxWidth === undefined ? undefined : styles.maxWidth[maxWidth],
    className,
  ]}
>
  <slot />
</div>
