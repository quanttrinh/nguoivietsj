---
// @boundary client
import { localized } from "~/generated/client/TicketTypeForm";
import type { Locale as DeclaredLocales } from "~/platform/i18n";

import TicketTypeFormIsland from "./TicketTypeForm.tsx";

interface Props {
  locale: DeclaredLocales;
  mode: "create" | "edit";
}

const { locale, mode }: Props = Astro.props;

const labels = localized(locale);
---

<TicketTypeFormIsland client:load mode={mode} locale={locale} labels={labels} />
