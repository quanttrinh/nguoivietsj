---
// @boundary client
import { adminPageStyles as styles } from "~/features/events/admin/ui/shared/styles/admin-styles";
import type { Locale as DeclaredLocales } from "~/platform/i18n";
import QuiFormRuntime from "~/platform/ui/QuiFormRuntime.astro";

import EventTitle from "./EventTitle";

interface Props {
  title: string;
  locale: DeclaredLocales;
  titleId?: string;
  preserveTitle?: boolean;
  intro?: string | null;
}

const { title, locale, titleId, preserveTitle = false, intro = null }: Props = Astro.props;
---

<header class={styles.top}>
  {preserveTitle ? (
    <EventTitle
      client:load
      transition:persist="admin-event-title"
      class={styles.title}
      id={titleId}
      locale={locale}
      fallback={title}
    />
  ) : (
    <h1 id={titleId} class={styles.title}>
      {title}
    </h1>
  )}
  {intro !== null && intro.length > 0 ? <p class={styles.intro}>{intro}</p> : null}
  <slot />
</header>

<QuiFormRuntime />
