---
// @boundary astro
import { PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN } from "astro:env/client";

import { Image } from "astro:assets";
import { ClientRouter } from "astro:transitions";

import { css } from "styled-system/css";
import { container, grid, hstack, vstack, visuallyHidden, wrap } from "styled-system/patterns";
import {
  useLocale,
  getHTMLTextDir,
  getLocaleName,
  getLocalizedUrl,
  getPathWithoutLocale,
} from "~/platform/i18n";
import Eyebrow from "~/platform/ui/Eyebrow.astro";

import packageJson from "../../../../../package.json";
import favicon from "../../../../assets/favicon.png";
import logoSrc from "../../../../assets/logo.png";

import appStylesUrl from "../../../../app.css?url";
import themeStylesUrl from "@quanttrinh/qui/theme.css?url";

interface Props {
  title: string;
  description: string;
  brand: string;
  brandSubtitle: string;
  homeHref: string;
  skipHref: string;
  skipLabel: string;
  languageLabel: string;
  builtBy: string;
  noindex?: boolean;
}

const {
  title,
  description,
  brand,
  brandSubtitle,
  homeHref,
  skipHref,
  skipLabel,
  languageLabel,
  builtBy,
  noindex = false,
}: Props = Astro.props;
const { locale, availableLocales } = useLocale(Astro.url);
const capitalize = (value: string): string =>
  value.charAt(0).toLocaleUpperCase(locale) + value.slice(1);
const pathWithoutLocale = getPathWithoutLocale(Astro.url.pathname);
const currentSearch = Astro.url.search;
const languageHref = (item: string): string => {
  const localized = getLocalizedUrl(pathWithoutLocale, item);
  const path = localized.endsWith("/") ? localized : `${localized}/`;

  return `${path}${currentSearch}`;
};
const copyrightYear = new Date().getUTCFullYear();

const styles = {
  page: vstack({ minHeight: "screen", gap: "0", alignItems: "stretch" }),
  skip: css({
    position: "absolute",
    insetInlineStart: "4",
    top: "-20",
    zIndex: 100,
    borderRadius: "lg",
    backgroundColor: "primary",
    color: "onPrimary",
    paddingInline: "4",
    paddingBlock: "2",
    fontWeight: "semibold",
    textDecoration: "none",
    transition: "top 150ms ease",
    _focusVisible: { top: "4" },
  }),
  header: wrap({
    width: "full",
    maxWidth: "8xl",
    marginInline: "auto",
    paddingInline: { base: "5", md: "10" },
    paddingBlock: { base: "4", md: "7" },
    align: "center",
    justify: "space-between",
    gap: { base: "3", md: "4" },
  }),
  brand: hstack({
    gap: "3",
    color: "onSurface",
    textDecoration: "none",
    width: { base: "full", md: "auto" },
    minW: 0,
  }),
  logo: css({
    width: "auto",
    height: { base: "10", md: "12" },
    maxWidth: "full",
    flexShrink: 0,
    objectFit: "contain",
    paddingY: "1",
  }),
  brandText: vstack({ alignItems: "flex-start", gap: "0.5", minW: 0 }),
  brandSubtitle: css({ display: { base: "none", md: "inline" } }),
  brandName: css({
    fontFamily: "display",
    fontSize: { base: "lg", md: "xl" },
    fontWeight: "bold",
    lineHeight: "none",
    letterSpacing: "tight",
  }),
  headerActions: hstack({
    gap: { base: "2", md: "3" },
    alignItems: "center",
    justify: "flex-end",
    flexWrap: "wrap",
    width: { base: "full", md: "auto" },
  }),
  languageNav: hstack({
    gap: "1",
    borderRadius: "full",
    borderWidth: "thin",
    borderStyle: "solid",
    borderColor: "outlineVariant",
    backgroundColor: "surfaceContainerLowest",
    padding: "1",
    boxShadow: "xs",
    flexShrink: 1,
    maxWidth: "full",
  }),
  languageLabel: visuallyHidden(),
  languageLink: css({
    borderRadius: "full",
    paddingInline: { base: "2", md: "3" },
    paddingBlock: "1.5",
    fontSize: "xs",
    whiteSpace: "nowrap",
    fontWeight: "semibold",
    color: "onSurfaceVariant",
    textDecoration: "none",
    _hover: { backgroundColor: "surfaceContainerHigh", color: "onSurface" },
    _focusVisible: {
      outlineWidth: "thick",
      outlineStyle: "solid",
      outlineColor: "primary",
      outlineOffset: "0.5",
    },
    '&[aria-current="page"]': {
      backgroundColor: "primary",
      color: "onPrimary",
      _hover: { backgroundColor: "primaryContainer", color: "onPrimaryContainer" },
    },
  }),
  main: container({
    flex: "1",
    width: "full",
    maxWidth: "8xl",
    paddingInline: { base: "5", md: "10" },
    paddingBlockEnd: { base: "10", md: "16" },
  }),
  footer: grid({
    width: "full",
    maxWidth: "8xl",
    marginInline: "auto",
    paddingInline: { base: "5", md: "10" },
    paddingBlock: "6",
    columns: { base: 1, sm: 3 },
    gap: "2",
    alignItems: "center",
    borderTopWidth: "thin",
    borderTopStyle: "solid",
    borderColor: "outlineVariant",
    color: "onSurfaceVariant",
    fontSize: "xs",
  }),
  footerVersion: css({
    justifySelf: { base: "center", sm: "start" },
  }),
  footerCredit: css({
    justifySelf: "center",
    textAlign: "center",
  }),
  footerCopyright: css({
    justifySelf: { base: "center", sm: "end" },
  }),
};
---

<!doctype html>
<html lang={locale} dir={getHTMLTextDir()}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="64x64" href={favicon.src} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="stylesheet" href={themeStylesUrl} data-astro-transition-persist="theme-stylesheet" />
    <link
      rel="stylesheet"
      href={appStylesUrl}
      data-qui-styles
      data-astro-transition-persist="app-stylesheet"
    />
    <ClientRouter />
    {PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN.length > 0 && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN })}
      />
    )}
  </head>
  <body>
    <div class={styles.page}>
      <a class={styles.skip} href={skipHref}>
        {skipLabel}
      </a>

      <header class={styles.header}>
        <a class={styles.brand} href={homeHref}>
          <Image
            class={styles.logo}
            src={logoSrc}
            alt={brand}
            widths={[96, 192, 384]}
            sizes="(min-width: 768px) 110px, 92px"
            loading="eager"
          />
          <span class={styles.brandText}>
            <span class={styles.brandName}>{brand}</span>
            <span class={styles.brandSubtitle}>
              <Eyebrow as="span">{brandSubtitle}</Eyebrow>
            </span>
          </span>
        </a>

        <div class={styles.headerActions}>
          <slot name="header-actions" />
          <nav class={styles.languageNav} aria-label={languageLabel}>
            <span class={styles.languageLabel}>{languageLabel}</span>
            {availableLocales.map((item) => (
              <a
                class={styles.languageLink}
                href={languageHref(item)}
                data-language-link
                hreflang={item}
                lang={item}
                aria-current={item === locale ? "page" : undefined}
              >
                {capitalize(getLocaleName(item))}
              </a>
            ))}
          </nav>
        </div>
      </header>

      <main id="main" class={styles.main}>
        <slot />
      </main>

      <footer class={styles.footer}>
        <span class={styles.footerVersion}>v{packageJson.version}</span>
        <span class={styles.footerCredit}>{builtBy}</span>
        <span class={styles.footerCopyright}>© {copyrightYear}</span>
      </footer>
    </div>

    <script>
      import { initLanguageLinks } from "~/platform/client/language-links";
      import { initRouterLinks } from "~/platform/client/router-links";

      initLanguageLinks();
      initRouterLinks();
    </script>
  </body>
</html>
