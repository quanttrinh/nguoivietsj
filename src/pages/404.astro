---
// @boundary astro
import { localized as all } from "~/generated/client/all";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { useLocale, getLocalizedUrl } from "~/shared/i18n";
import { guardPageStyles as styles } from "~/shared/ui/guard-page-styles";

Astro.response.status = 404;

const { locale } = useLocale(Astro.url);
const messages = all(locale);
---

<BaseLayout
  title={`${messages.site.notFound.title} · ${messages.site.brand}`}
  description={messages.site.notFound.message}
>
  <section class={styles.section}>
    <div class={styles.panel}>
      <h1 class={styles.title}>{messages.site.notFound.title}</h1>
      <p class={styles.message}>{messages.site.notFound.message}</p>
      <qui-button href={getLocalizedUrl("/", locale)} variant="filled">
        {messages.site.backToHome}
      </qui-button>
    </div>
  </section>

  <script>
    import "virtual:qui/register?components=qui-button";
  </script>
</BaseLayout>
