---
// @boundary astro
import AdminCatalog from "~/features/events/admin/ui/catalog/AdminCatalog";
import AdminLayout from "~/features/events/admin/ui/shared/AdminLayout.astro";
import { localized } from "~/generated/client/AdminCatalog";
import { localized as all } from "~/generated/client/all";
import { locales, useLocale } from "~/platform/i18n";

export function getStaticPaths(): { params: { locale: string } }[] {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = useLocale(Astro.url);
const content = all(locale);

const view = localized(locale);
---

<AdminLayout title={content.engineAdmin.title} description={content.engineAdmin.intro} noindex>
  <AdminCatalog
    client:load
    locale={locale}
    labels={view}
    pageOfParts={[...content.engineAdmin.pageOfParts]}
  />
</AdminLayout>
