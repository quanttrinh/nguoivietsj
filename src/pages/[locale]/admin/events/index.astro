---
// @boundary astro
import { useDictionary, useLocale } from "astro-intlayer";
import { locales } from "intlayer";

import AdminCatalog from "~/events/admin/ui/catalog/AdminCatalog";
import AdminLayout from "~/events/admin/ui/shared/AdminLayout.astro";
import engineAdminContent from "~/events/content/admin.content";

export function getStaticPaths(): { params: { locale: string } }[] {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = useLocale();
const content = useDictionary(engineAdminContent, locale);

const config = {
  locale,
  title: content.title.value,
  intro: content.intro.value,
  staffTitle: content.staffTitle.value,
  staffIntro: content.staffIntro.value,
  newEvent: content.newEvent.value,
  noEvents: content.noEvents.value,
  registrationCount: content.registrationCount.value,
  ticketsTotal: content.ticketsTotal.value,
  previousPage: content.previousPage.value,
  nextPage: content.nextPage.value,
  pageOfParts: content.pageOfParts.map((part) => part.value),
  loadFailed: content.loadFailed.value,
  forbidden: content.forbidden.value,
};
---

<AdminLayout title={content.title.value} description={content.intro.value} noindex>
  <AdminCatalog client:load config={config} />
</AdminLayout>
