---
// @boundary astro
import AdminEventDetail from "~/events/admin/ui/detail/AdminEventDetail";
import AdminLayout from "~/events/admin/ui/shared/AdminLayout.astro";
import { localized } from "~/generated/client/AdminEventDetail";
import { localized as all } from "~/generated/client/all";
import { locales, useLocale } from "~/shared/i18n";

export function getStaticPaths(): { params: { locale: string } }[] {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = useLocale(Astro.url);
const content = all(locale);

const labels = localized(locale);
---

<AdminLayout title={content.shared.event} description={content.engineAdmin.intro} noindex>
  <AdminEventDetail client:load locale={locale} labels={labels} />
</AdminLayout>
