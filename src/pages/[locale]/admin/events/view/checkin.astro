---
// @boundary astro
import AdminCheckinScanner from "~/features/events/admin/ui/checkin/AdminCheckinScanner";
import AdminEventTitleLoader from "~/features/events/admin/ui/shared/AdminEventTitleLoader.astro";
import AdminLayout from "~/features/events/admin/ui/shared/AdminLayout.astro";
import AdminPageHeader from "~/features/events/admin/ui/shared/AdminPageHeader.astro";
import { adminPageStyles } from "~/features/events/admin/ui/shared/styles/admin-styles";
import { localized } from "~/generated/client/AdminCheckinScanner";
import { localized as all } from "~/generated/client/all";
import { locales, useLocale } from "~/platform/i18n";
import Panel from "~/platform/ui/Panel.astro";

export function getStaticPaths(): { params: { locale: string } }[] {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = useLocale(Astro.url);
const content = all(locale);

const styles = {
  section: adminPageStyles.section,
};

const view = localized(locale);
---

<AdminLayout title={content.engineCheckin.title} description={content.engineCheckin.intro} noindex>
  <section class={styles.section} id="engine-admin-checkin">
    <AdminEventTitleLoader />
    <AdminPageHeader
      locale={locale}
      title=""
      titleId="engine-checkin-title"
      preserveTitle
      intro={content.engineCheckin.intro}
    />

    <Panel padding="lg">
      <AdminCheckinScanner client:load locale={locale} labels={view} />
    </Panel>
  </section>
</AdminLayout>
