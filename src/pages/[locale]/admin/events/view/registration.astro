---
// @boundary astro
import AdminRegistration from "~/features/events/admin/ui/registration/AdminRegistration";
import AdminLayout from "~/features/events/admin/ui/shared/AdminLayout.astro";
import AdminPageHeader from "~/features/events/admin/ui/shared/AdminPageHeader.astro";
import { adminPageStyles } from "~/features/events/admin/ui/shared/styles/admin-styles";
import { localized } from "~/generated/client/AdminRegistration";
import { localized as all } from "~/generated/client/all";
import { locales, useLocale } from "~/platform/i18n";
import Panel from "~/platform/ui/Panel.astro";

export function getStaticPaths(): { params: { locale: string } }[] {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = useLocale(Astro.url);
const content = all(locale);
const view = localized(locale);
---

<AdminLayout
  title={content.shared.registrationDetails}
  description={content.engineAdmin.registrationDetailIntro}
  noindex
>
  <section class={adminPageStyles.section} id="engine-admin-registration">
    <AdminPageHeader
      locale={locale}
      title=""
      titleId="engine-registration-detail-title"
      preserveTitle
      intro={content.engineAdmin.registrationDetailIntro}
    />
    <Panel padding="lg">
      <AdminRegistration client:load locale={locale} labels={view} />
    </Panel>
  </section>
</AdminLayout>
