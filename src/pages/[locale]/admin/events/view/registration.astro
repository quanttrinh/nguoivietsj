---
// @boundary astro
import { getBasePlugins, getDictionary } from "@intlayer/core/interpreter";
import { useDictionary, useLocale } from "astro-intlayer";
import { locales } from "intlayer";

import AdminRegistration from "~/events/admin/ui/registration/AdminRegistration";
import AdminLayout from "~/events/admin/ui/shared/AdminLayout.astro";
import AdminPageHeader from "~/events/admin/ui/shared/AdminPageHeader.astro";
import { adminPageStyles } from "~/events/admin/ui/shared/styles/admin-styles";
import engineContent from "~/events/content/admin.content";
import { registrationCardLabelKeys } from "~/events/ui/registration/labels";
import { pick } from "~/shared/content/pick";
import Panel from "~/shared/ui/Panel.astro";

export function getStaticPaths(): { params: { locale: string } }[] {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = useLocale();
const content = useDictionary(engineContent, locale);
const view = pick(getDictionary(engineContent, locale, getBasePlugins(locale)), [
  ...registrationCardLabelKeys,
  "loadFailed",
  "loading",
  "qrCode",
  "registrationDetail",
  "supportLink",
]);
---

<AdminLayout
  title={content.registrationDetail.value}
  description={content.registrationDetailIntro.value}
  noindex
>
  <section class={adminPageStyles.section} id="engine-admin-registration">
    <AdminPageHeader
      locale={locale}
      title=""
      titleId="engine-registration-detail-title"
      preserveTitle
      intro={content.registrationDetailIntro.value}
    />
    <Panel padding="lg">
      <AdminRegistration client:load locale={locale} labels={view} />
    </Panel>
  </section>
</AdminLayout>
