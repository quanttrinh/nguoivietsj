---
// @boundary astro
import AdminLayout from "~/events/admin/ui/shared/AdminLayout.astro";
import AdminPageHeader from "~/events/admin/ui/shared/AdminPageHeader.astro";
import { adminPageStyles } from "~/events/admin/ui/shared/styles/admin-styles";
import AdminSupport from "~/events/admin/ui/support/AdminSupport";
import { localized } from "~/generated/client/AdminSupport";
import { localized as all } from "~/generated/client/all";
import { locales, useLocale } from "~/shared/i18n";
import Panel from "~/shared/ui/Panel.astro";

export function getStaticPaths(): { params: { locale: string } }[] {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = useLocale(Astro.url);
const content = all(locale);
const view = localized(locale);

const styles = {
  section: adminPageStyles.section,
  actions: adminPageStyles.actions,
};
---

<AdminLayout
  title={content.shared.registrationSupport}
  description={content.engineAdmin.supportIntro}
  noindex
>
  <section class={styles.section} id="engine-admin-support">
    <AdminPageHeader
      locale={locale}
      title=""
      titleId="engine-support-title"
      preserveTitle
      intro={content.engineAdmin.supportIntro}
    >
      <div class={styles.actions}>
        <qui-button data-event-link="register" href="#" variant="filled">
          {content.engineAdmin.createRegistration}
        </qui-button>
        <qui-button data-event-link="checkin" href="#" variant="outlined">
          {content.shared.checkIn}
        </qui-button>
        <qui-button data-event-link="activity" href="#" variant="outlined">
          {content.shared.activity}
        </qui-button>
      </div>
    </AdminPageHeader>

    <Panel padding="lg">
      <AdminSupport client:load locale={locale} labels={view} />
    </Panel>
  </section>
</AdminLayout>

<script>
  import "virtual:qui/register?components=qui-button";
</script>
