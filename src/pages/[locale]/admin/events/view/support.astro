---
// @boundary astro
import { getBasePlugins, getDictionary } from "@intlayer/core/interpreter";
import { useDictionary, useLocale } from "astro-intlayer";
import { locales } from "intlayer";

import AdminLayout from "~/events/admin/ui/shared/AdminLayout.astro";
import AdminPageHeader from "~/events/admin/ui/shared/AdminPageHeader.astro";
import { adminPageStyles } from "~/events/admin/ui/shared/styles/admin-styles";
import AdminSupport from "~/events/admin/ui/support/AdminSupport";
import engineContent from "~/events/content/admin.content";
import { pick } from "~/shared/content/pick";
import Panel from "~/shared/ui/Panel.astro";

export function getStaticPaths(): { params: { locale: string } }[] {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = useLocale();
const content = useDictionary(engineContent, locale);
const view = pick(getDictionary(engineContent, locale, getBasePlugins(locale)), [
  "support",
  "results",
  "noResults",
  "fullName",
  "contact",
  "ticketsTotal",
  "amountDue",
  "paymentStatus",
  "checkinFilter",
  "createdAt",
  "qrCode",
  "paid",
  "unpaid",
  "checkedIn",
  "notCheckedIn",
  "notAvailable",
  "cashPayment",
  "etransferPayment",
  "otherPayment",
  "confirmPayment",
  "updatePayment",
  "removePayment",
  "removePaymentConfirm",
  "paymentMethod",
  "paymentNote",
  "paymentNoteRequired",
  "paymentFailed",
  "paymentSaved",
  "paymentRemoved",
  "paymentEmailFailed",
  "savingPayment",
  "otherPaymentNoteHelp",
  "previousPage",
  "nextPage",
  "loadFailed",
  "eventNotFound",
  "search",
  "searchPlaceholder",
  "paymentFilter",
  "all",
  "searchAction",
  "clearFilters",
  "userClose",
]);

const styles = {
  section: adminPageStyles.section,
  actions: adminPageStyles.actions,
};
---

<AdminLayout title={content.support.value} description={content.supportIntro.value} noindex>
  <section class={styles.section} id="engine-admin-support">
    <AdminPageHeader
      locale={locale}
      title=""
      titleId="engine-support-title"
      preserveTitle
      intro={content.supportIntro.value}
    >
      <div class={styles.actions}>
        <qui-button data-event-link="register" href="#" variant="filled">
          {content.createRegistration.value}
        </qui-button>
        <qui-button data-event-link="checkin" href="#" variant="outlined">
          {content.checkIn.value}
        </qui-button>
        <qui-button data-event-link="activity" href="#" variant="outlined">
          {content.activity.value}
        </qui-button>
      </div>
    </AdminPageHeader>

    <Panel padding="lg">
      <AdminSupport client:load locale={locale} labels={view} />
    </Panel>
  </section>
</AdminLayout>

<script>
  import "virtual:qui/register?components=qui-button";
</script>
