---
// @boundary astro
import AdminActivity from "~/events/admin/ui/catalog/AdminActivity";
import AdminLayout from "~/events/admin/ui/shared/AdminLayout.astro";
import AdminPageHeader from "~/events/admin/ui/shared/AdminPageHeader.astro";
import { adminPageStyles } from "~/events/admin/ui/shared/styles/admin-styles";
import { localized } from "~/generated/client/AdminActivity";
import { localized as all } from "~/generated/client/all";
import { locales, useLocale } from "~/shared/i18n";
import Panel from "~/shared/ui/Panel.astro";

export function getStaticPaths(): { params: { locale: string } }[] {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = useLocale(Astro.url);
const content = all(locale);

const view = localized(locale);
---

<AdminLayout
  title={content.shared.activity}
  description={content.engineAdmin.activityIntro}
  noindex
>
  <section class={adminPageStyles.section}>
    <AdminPageHeader
      locale={locale}
      title=""
      titleId="engine-activity-title"
      preserveTitle
      intro={content.engineAdmin.activityIntro}
    />

    <Panel padding="lg">
      <AdminActivity client:load locale={locale} labels={view} />
    </Panel>
  </section>
</AdminLayout>
