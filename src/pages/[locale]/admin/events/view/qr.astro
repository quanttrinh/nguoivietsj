---
// @boundary astro
import { center } from "styled-system/patterns";
import AdminQr from "~/features/events/admin/ui/qr/AdminQr";
import AdminLayout from "~/features/events/admin/ui/shared/AdminLayout.astro";
import { localized } from "~/generated/client/AdminQr";
import { localized as all } from "~/generated/client/all";
import { locales, useLocale } from "~/platform/i18n";
import Panel from "~/platform/ui/Panel.astro";

export function getStaticPaths(): { params: { locale: string } }[] {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = useLocale(Astro.url);
const content = all(locale);

const styles = {
  section: center({ paddingBlockStart: { base: "2", md: "3" } }),
};

const view = localized(locale);
---

<AdminLayout
  title={content.engineCheckin.qrTitle}
  description={content.engineCheckin.qrHelp}
  noindex
>
  <section class={styles.section}>
    <Panel padding="lg">
      <AdminQr client:load locale={locale} labels={view} />
    </Panel>
  </section>
</AdminLayout>
