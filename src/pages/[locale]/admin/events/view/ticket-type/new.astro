---
// @boundary astro
import TicketTypeForm from "~/events/admin/ui/forms/TicketTypeForm.astro";
import AdminLayout from "~/events/admin/ui/shared/AdminLayout.astro";
import AdminPageHeader from "~/events/admin/ui/shared/AdminPageHeader.astro";
import { adminPageStyles } from "~/events/admin/ui/shared/styles/admin-styles";
import { localized as all } from "~/generated/client/all";
import { locales, useLocale } from "~/shared/i18n";

export function getStaticPaths(): { params: { locale: string } }[] {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = useLocale(Astro.url);
const content = all(locale);
---

<AdminLayout
  title={content.shared.newTicketType}
  description={content.engineAdmin.ticketTypeIntro}
  noindex
>
  <section class={adminPageStyles.section}>
    <AdminPageHeader locale={locale} title={content.shared.newTicketType} />

    <TicketTypeForm locale={locale} mode="create" />
  </section>
</AdminLayout>
