---
// @boundary astro
import { useDictionary, useLocale } from "astro-intlayer";
import { locales } from "intlayer";

import AdminHomeCards from "~/events/admin/ui/shared/AdminHomeCards";
import AdminLayout from "~/events/admin/ui/shared/AdminLayout.astro";
import AdminPageHeader from "~/events/admin/ui/shared/AdminPageHeader.astro";
import { adminCatalogUrl, adminUsersUrl } from "~/events/admin/ui/shared/routes";
import { adminPageStyles } from "~/events/admin/ui/shared/styles/admin-styles";
import engineAdminContent from "~/events/content/admin.content";
import Panel from "~/shared/ui/Panel.astro";

export function getStaticPaths(): { params: { locale: string } }[] {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = useLocale();
const content = useDictionary(engineAdminContent, locale);

const cards = [
  {
    href: adminUsersUrl(locale),
    title: content.manageUsers.value,
    help: content.manageUsersHelp.value,
    action: content.openSection.value,
    permission: "users" as const,
  },
  {
    href: adminCatalogUrl(locale),
    title: content.manageEvents.value,
    help: content.manageEventsHelp.value,
    action: content.openSection.value,
    permission: "events" as const,
  },
];
---

<AdminLayout title={content.adminHome.value} description={content.adminHomeIntro.value} noindex>
  <section class={adminPageStyles.section} id="engine-admin-home">
    <AdminPageHeader
      locale={locale}
      title={content.adminHome.value}
      intro={content.adminHomeIntro}
    />

    <Panel padding="lg">
      <AdminHomeCards client:load config={{ cards, empty: content.noAdminSections.value }} />
    </Panel>
  </section>
</AdminLayout>
