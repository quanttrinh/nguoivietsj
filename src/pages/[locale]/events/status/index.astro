---
// @boundary astro
import { getBasePlugins, getDictionary } from "@intlayer/core/interpreter";
import { useDictionary, useLocale } from "astro-intlayer";
import { locales } from "intlayer";

import { css } from "styled-system/css";
import { vstack } from "styled-system/patterns";
import engineContent from "~/events/content/status.content";
import StatusRequest from "~/events/status/ui/StatusRequest";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { pick } from "~/shared/content/pick";
import Panel from "~/shared/ui/Panel.astro";
import QuiFormRuntime from "~/shared/ui/QuiFormRuntime.astro";

export function getStaticPaths(): { params: { locale: string } }[] {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = useLocale();
const content = useDictionary(engineContent, locale);

const styles = {
  section: vstack({ alignItems: "stretch", gap: "6", paddingBlockStart: { base: "2", md: "3" } }),
  title: css({
    margin: "0",
    fontFamily: "display",
    fontSize: { base: "4xl", md: "5xl" },
    lineHeight: "none",
    letterSpacing: "tight",
    fontWeight: "bold",
  }),
  intro: css({ margin: "0", maxWidth: "2xl", fontSize: "md", color: "onSurfaceVariant" }),
  link: css({
    fontSize: "sm",
    fontWeight: "semibold",
    color: "primary",
    textDecoration: "underline",
    textUnderlineOffset: "0.5",
  }),
};

const view = pick(getDictionary(engineContent, locale, getBasePlugins(locale)), [
  "codeInvalid",
  "codeLabel",
  "codeSent",
  "codeUnavailable",
  "emailLabel",
  "registrationId",
  "requestCode",
  "verifyCode",
]);
---

<BaseLayout title={content.metaTitle.value} description={content.metaDescription.value} noindex>
  <section id="engine-status-request" class={styles.section}>
    <h1 class={styles.title}>{content.accessTitle.value}</h1>
    <p class={styles.intro}>{content.accessIntro.value}</p>
    <a class={styles.link} href={`/${locale}/events`}>
      {content.backToEvents.value}
    </a>

    <Panel padding="lg" maxWidth="2xl">
      <StatusRequest client:load locale={locale} labels={view} />
    </Panel>
  </section>

  <QuiFormRuntime />
</BaseLayout>
