---
// @boundary astro
import { css } from "styled-system/css";
import { vstack } from "styled-system/patterns";
import StatusRequest from "~/events/status/ui/StatusRequest";
import { localized as all } from "~/generated/client/all";
import { localized } from "~/generated/client/StatusRequest";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { locales, useLocale } from "~/shared/i18n";
import Panel from "~/shared/ui/Panel.astro";
import QuiFormRuntime from "~/shared/ui/QuiFormRuntime.astro";

export function getStaticPaths(): { params: { locale: string } }[] {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = useLocale(Astro.url);
const content = all(locale);

const styles = {
  section: vstack({ alignItems: "stretch", gap: "6", paddingBlockStart: { base: "2", md: "3" } }),
  title: css({
    margin: "0",
    fontFamily: "display",
    fontSize: { base: "4xl", md: "5xl" },
    lineHeight: "none",
    letterSpacing: "tight",
    fontWeight: "bold",
  }),
  intro: css({ margin: "0", maxWidth: "2xl", fontSize: "md", color: "onSurfaceVariant" }),
  link: css({
    fontSize: "sm",
    fontWeight: "semibold",
    color: "primary",
    textDecoration: "underline",
    textUnderlineOffset: "0.5",
  }),
};

const view = localized(locale);
---

<BaseLayout
  title={content.engineRegistrationStatus.metaTitle}
  description={content.engineRegistrationStatus.metaDescription}
  noindex
>
  <section id="engine-status-request" class={styles.section}>
    <h1 class={styles.title}>{content.engineRegistrationStatus.accessTitle}</h1>
    <p class={styles.intro}>{content.engineRegistrationStatus.accessIntro}</p>
    <a class={styles.link} href={`/${locale}/events`}>
      {content.shared.backToEvents}
    </a>

    <Panel padding="lg" maxWidth="2xl">
      <StatusRequest client:load locale={locale} labels={view} />
    </Panel>
  </section>

  <QuiFormRuntime />
</BaseLayout>
