---
// @boundary astro
import { css } from "styled-system/css";
import { vstack } from "styled-system/patterns";
import EventList from "~/events/list/ui/EventList";
import { localized as all } from "~/generated/client/all";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { locales, useLocale } from "~/shared/i18n";
import Panel from "~/shared/ui/Panel.astro";

export function getStaticPaths(): { params: { locale: string } }[] {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = useLocale(Astro.url);
const content = all(locale);

const messages = {
  noEvents: content.engineEvents.noEvents,
  unavailable: content.engineEvents.unavailable,
  viewEvent: content.engineEvents.viewEvent,
  register: content.shared.register,
  registrationClosed: content.engineEvents.registrationClosed,
};

const styles = {
  section: vstack({ alignItems: "stretch", gap: "7", paddingBlockStart: { base: "2", md: "3" } }),
  heading: vstack({ alignItems: "stretch", gap: "2" }),
  title: css({
    margin: "0",
    fontFamily: "display",
    fontSize: { base: "4xl", md: "5xl" },
    lineHeight: "none",
    letterSpacing: "tight",
    fontWeight: "bold",
  }),
  intro: css({ margin: "0", maxWidth: "2xl", fontSize: "md", color: "onSurfaceVariant" }),
  empty: css({ margin: "0", fontSize: "sm", color: "onSurfaceVariant" }),
};
---

<BaseLayout
  title={content.engineEvents.meta.title}
  description={content.engineEvents.meta.description}
>
  <section class={styles.section}>
    <div class={styles.heading}>
      <h1 class={styles.title}>{content.shared.events}</h1>
      <p class={styles.intro}>{content.engineEvents.intro}</p>
    </div>

    <EventList client:load locale={locale} messages={messages} />
    <noscript>
      <Panel padding="lg">
        <p class={styles.empty}>{content.engineEvents.noscript}</p>
      </Panel>
    </noscript>
  </section>
</BaseLayout>
