---
// @boundary client
import { useDictionary, useLocale } from "astro-intlayer";

import { css } from "styled-system/css";
import { vstack } from "styled-system/patterns";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { noticeStyles } from "~/shared/ui/notice-styles";
import Panel from "~/shared/ui/Panel.astro";
import QuiFormRuntime from "~/shared/ui/QuiFormRuntime.astro";

import loginContent from "../content/login.content";

const { locale } = useLocale();
const content = useDictionary(loginContent, locale);

const styles = {
  section: vstack({ alignItems: "stretch", gap: "6", paddingBlockStart: { base: "2", md: "3" } }),
  title: css({
    margin: "0",
    fontFamily: "display",
    fontSize: { base: "4xl", md: "5xl" },
    lineHeight: "none",
    letterSpacing: "tight",
    fontWeight: "bold",
  }),
  intro: css({ margin: "0", maxWidth: "2xl", fontSize: "md", color: "onSurfaceVariant" }),
  form: vstack({ alignItems: "stretch", gap: "4", maxW: "xl", "&[hidden]": { display: "none" } }),
  codeHeading: css({ margin: "0", textStyle: "title-sm" }),
  codeHint: css({ margin: "0", textStyle: "body-md", color: "onSurfaceVariant" }),
  methods: css({ display: "flex", flexWrap: "wrap", gap: "2" }),
  noticeShell: css({ paddingBlockEnd: "5" }),
  notice: noticeStyles.error,
};
---

<BaseLayout title={content.metaTitle.value} description={content.metaDescription.value} noindex>
  <section id="login" class={styles.section}>
    <h1 class={styles.title}>{content.heading.value}</h1>
    <p class={styles.intro}>{content.intro.value}</p>

    <Panel padding="lg" maxWidth="2xl">
      <div data-login-notice class={styles.noticeShell} hidden>
        <div class={styles.notice} role="alert" tabindex="-1"></div>
      </div>

      <form
        data-login-form
        class={styles.form}
        novalidate
        data-submitting-label={content.submitting.value}
        data-failed-message={content.signInFailed.value}
        data-unavailable-message={content.unavailable.value}
        data-required-message={content.fieldsRequired.value}
        data-locale={locale}
      >
        <qui-field>
          <qui-field-label>{content.emailLabel.value}</qui-field-label>
          <qui-input
            id="login-email"
            name="email"
            input-type="text"
            input-mode-hint="email"
            input-pattern="[^\s@]+@[^\s@]+\.[^\s@]+"
            autocomplete="email"
            required
          />
        </qui-field>
        <qui-field>
          <qui-field-label>{content.passwordLabel.value}</qui-field-label>
          <qui-input
            id="login-password"
            name="password"
            input-type="password"
            autocomplete="current-password"
            required
          />
        </qui-field>
        <qui-checkbox name="rememberMe" value="true">
          {content.rememberMe.value}
        </qui-checkbox>
        <qui-button type="submit" variant="filled">
          {content.submit.value}
        </qui-button>
      </form>

      <form
        data-login-code
        class={styles.form}
        novalidate
        hidden
        data-method="totp"
        data-hint-totp={content.codeHintTotp.value}
        data-hint-email={content.codeHintEmail.value}
        data-hint-backup={content.codeHintBackup.value}
        data-required-message={content.codeRequired.value}
        data-failed-message={content.signInFailed.value}
        data-unavailable-message={content.unavailable.value}
      >
        <h2 class={styles.codeHeading}>{content.codeHeading.value}</h2>
        <p data-code-hint class={styles.codeHint}>
          {content.codeHintTotp.value}
        </p>
        <qui-field>
          <qui-field-label>{content.codeLabel.value}</qui-field-label>
          <qui-input
            id="login-code"
            name="code"
            input-type="text"
            input-mode-hint="numeric"
            autocomplete="one-time-code"
            required
          />
        </qui-field>
        <qui-checkbox name="trustDevice" value="true">
          {content.trustDevice.value}
        </qui-checkbox>
        <qui-button type="submit" variant="filled">
          {content.verify.value}
        </qui-button>
        <div class={styles.methods}>
          <qui-button type="button" variant="text" data-code-method="totp" hidden>
            {content.useTotp.value}
          </qui-button>
          <qui-button type="button" variant="text" data-code-method="email">
            {content.useEmail.value}
          </qui-button>
          <qui-button type="button" variant="text" data-code-method="backup">
            {content.useBackup.value}
          </qui-button>
        </div>
      </form>
    </Panel>
  </section>

  <QuiFormRuntime />
</BaseLayout>

<script>
  import { navigate } from "astro:transitions/client";
  import "virtual:qui/register?components=qui-field,qui-field-label,qui-input,qui-checkbox,qui-button";

  import { signInEmail } from "~/auth/client/sign-in";
  import {
    sendTwoFactorEmail,
    verifyTwoFactor,
    type TwoFactorMethod,
  } from "~/auth/client/two-factor";
  import { readFormChecked, readFormValue } from "~/shared/client/form-controls";
  import { clientLogger } from "~/shared/client/logger";
  import { safeRedirect } from "~/shared/client/navigation";

  function showNotice(message: string): void {
    const shell = document.querySelector<HTMLElement>("[data-login-notice]");
    const box = shell?.querySelector<HTMLElement>("[role='alert']");

    if (shell == null || box == null || message.length === 0) {
      return;
    }

    box.textContent = message;
    shell.hidden = false;
    box.focus();
  }

  function formMessage(form: HTMLFormElement, key: string): string {
    return form.dataset[key] ?? "";
  }

  function codeForm(): HTMLFormElement | null {
    return document.querySelector<HTMLFormElement>("[data-login-code]");
  }

  function showCodeStep(passwordForm: HTMLFormElement): void {
    const form = codeForm();

    if (form === null) {
      return;
    }

    passwordForm.hidden = true;
    form.hidden = false;
    form.querySelector<HTMLElement>("#login-code")?.focus();
  }

  async function submitLogin(form: HTMLFormElement): Promise<void> {
    const button = form.querySelector<HTMLQuiButtonElement>("qui-button[type='submit']");
    const email = readFormValue(form, "email").trim();
    const password = readFormValue(form, "password");

    if (button?.disabled === true) {
      return;
    }

    if (email.length === 0 || password.length === 0) {
      showNotice(formMessage(form, "requiredMessage"));
      return;
    }

    if (button != null) {
      button.disabled = true;
      button.label = formMessage(form, "submittingLabel");
    }

    try {
      const result = await signInEmail({
        email,
        password,
        rememberMe: readFormChecked(form, "rememberMe"),
        ...(form.dataset.locale === undefined ? {} : { locale: form.dataset.locale }),
      });

      if (result.status === "error") {
        clientLogger.error(result.message);
        showNotice(result.message.length > 0 ? result.message : formMessage(form, "failedMessage"));
        return;
      }

      if (result.status === "two-factor") {
        showCodeStep(form);
        return;
      }

      await navigate(
        safeRedirect(globalThis.location.search, {
          origin: globalThis.location.origin,
        }),
      );
    } catch (error) {
      clientLogger.error(error);
      showNotice(formMessage(form, "unavailableMessage"));
    } finally {
      if (button != null) {
        button.disabled = false;
        button.removeAttribute("label");
      }
    }
  }

  const HINTS: Record<TwoFactorMethod, string> = {
    totp: "hintTotp",
    email: "hintEmail",
    backup: "hintBackup",
  };

  function isMethod(value: string | undefined): value is TwoFactorMethod {
    return value === "totp" || value === "email" || value === "backup";
  }

  async function selectMethod(form: HTMLFormElement, method: TwoFactorMethod): Promise<void> {
    if (method === "email") {
      const error = await sendTwoFactorEmail();

      if (error !== null) {
        showNotice(error);
        return;
      }
    }

    form.dataset.method = method;
    const hint = form.querySelector<HTMLElement>("[data-code-hint]");

    if (hint !== null) {
      hint.textContent = formMessage(form, HINTS[method]);
    }

    for (const button of form.querySelectorAll<HTMLElement>("[data-code-method]")) {
      button.hidden = button.dataset.codeMethod === method;
    }
  }

  async function submitCode(form: HTMLFormElement): Promise<void> {
    const code = readFormValue(form, "code").trim();
    const method = form.dataset.method;

    if (!isMethod(method)) {
      return;
    }

    if (code.length === 0) {
      showNotice(formMessage(form, "requiredMessage"));
      return;
    }

    const error = await verifyTwoFactor({
      method,
      code,
      trustDevice: readFormChecked(form, "trustDevice"),
    });

    if (error !== null) {
      showNotice(error.length > 0 ? error : formMessage(form, "failedMessage"));
      return;
    }

    await navigate(
      safeRedirect(globalThis.location.search, {
        origin: globalThis.location.origin,
      }),
    );
  }

  async function guarded(form: HTMLFormElement, task: () => Promise<void>): Promise<void> {
    try {
      await task();
    } catch (error) {
      clientLogger.error(error);
      showNotice(formMessage(form, "unavailableMessage"));
    }
  }

  function initCodeForm(): void {
    const form = codeForm();

    if (form === null || form.dataset.ready === "true") {
      return;
    }

    form.dataset.ready = "true";
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      void guarded(form, () => submitCode(form));
    });
    form.addEventListener("keydown", (event) => {
      if (event.key === "Enter" && !event.defaultPrevented) {
        event.preventDefault();
        form.requestSubmit();
      }
    });

    for (const button of form.querySelectorAll<HTMLElement>("[data-code-method]")) {
      button.addEventListener("click", () => {
        const method = button.dataset.codeMethod;

        if (isMethod(method)) {
          void guarded(form, () => selectMethod(form, method));
        }
      });
    }
  }

  async function runLogin(form: HTMLFormElement): Promise<void> {
    try {
      await submitLogin(form);
    } catch (error) {
      clientLogger.error(error);
      showNotice(formMessage(form, "unavailableMessage"));
    }
  }

  function initLoginForm(): void {
    for (const form of document.querySelectorAll<HTMLFormElement>("[data-login-form]")) {
      if (form.dataset.ready !== "true") {
        form.dataset.ready = "true";
        form.addEventListener("submit", (event) => {
          event.preventDefault();
          void runLogin(form);
        });
        form.addEventListener("keydown", (event) => {
          if (event.key !== "Enter" || event.defaultPrevented) {
            return;
          }

          event.preventDefault();
          form.requestSubmit();
        });
      }
    }
  }

  document.addEventListener("astro:page-load", () => {
    initLoginForm();
    initCodeForm();
  });
</script>
