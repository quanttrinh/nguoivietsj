---
// @boundary client
import { useDictionary, useLocale } from "astro-intlayer";

import { css } from "styled-system/css";
import { vstack } from "styled-system/patterns";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { noticeStyles } from "~/shared/ui/notice-styles";
import Panel from "~/shared/ui/Panel.astro";
import QuiFormRuntime from "~/shared/ui/QuiFormRuntime.astro";

import setupContent from "../content/two-factor-setup.content";

const { locale } = useLocale();
const content = useDictionary(setupContent, locale);

const styles = {
  section: vstack({ alignItems: "stretch", gap: "6", paddingBlockStart: { base: "2", md: "3" } }),
  title: css({ margin: "0", textStyle: "headline-lg" }),
  intro: css({ margin: "0", maxWidth: "2xl", textStyle: "body-lg", color: "onSurfaceVariant" }),
  step: vstack({ alignItems: "stretch", gap: "4", maxW: "xl", "&[hidden]": { display: "none" } }),
  text: css({ margin: "0", textStyle: "body-md" }),
  qr: css({ width: "48", height: "48", "& svg": { width: "full", height: "full" } }),
  secret: css({ textStyle: "code-md", wordBreak: "break-all" }),
  codes: css({
    display: "grid",
    gridTemplateColumns: "repeat(2, minmax(0, 1fr))",
    gap: "2",
    textStyle: "code-md",
    listStyle: "none",
    padding: "0",
    margin: "0",
  }),
  noticeShell: css({ paddingBlockEnd: "5" }),
  notice: noticeStyles.error,
};
---

<BaseLayout title={content.metaTitle.value} description={content.intro.value} noindex>
  <section class={styles.section}>
    <h1 class={styles.title}>{content.heading}</h1>
    <p class={styles.intro}>{content.intro}</p>

    <Panel padding="lg" maxWidth="2xl">
      <div data-setup-notice class={styles.noticeShell} hidden>
        <div class={styles.notice} role="alert" tabindex="-1"></div>
      </div>

      <div
        data-two-factor-setup
        data-required={content.required.value}
        data-failed={content.failed.value}
        data-sign-in-first={content.signInFirst.value}
        data-login-href={`/${locale}/login`}
      >
        <form data-step="password" class={styles.step} novalidate>
          <qui-field>
            <qui-field-label>{content.passwordLabel}</qui-field-label>
            <qui-input
              name="password"
              input-type="password"
              autocomplete="current-password"
              required
            />
          </qui-field>
          <qui-button type="submit" variant="filled">
            {content.start}
          </qui-button>
        </form>

        <form data-step="verify" class={styles.step} novalidate hidden>
          <p class={styles.text}>{content.scan}</p>
          <div data-qr class={styles.qr}></div>
          <p class={styles.text}>
            {content.secretLabel} <code data-secret class={styles.secret}></code>
          </p>
          <qui-field>
            <qui-field-label>{content.codeLabel}</qui-field-label>
            <qui-input
              name="code"
              input-type="text"
              input-mode-hint="numeric"
              autocomplete="one-time-code"
              required
            />
          </qui-field>
          <qui-button type="submit" variant="filled">
            {content.confirm}
          </qui-button>
        </form>

        <div data-step="backup" class={styles.step} hidden>
          <h2 class={styles.text}>{content.backupHeading}</h2>
          <p class={styles.text}>{content.backupIntro}</p>
          <ul data-backup-codes class={styles.codes}></ul>
          <qui-button data-done variant="filled">
            {content.done}
          </qui-button>
        </div>
      </div>
    </Panel>
  </section>

  <QuiFormRuntime />
</BaseLayout>

<script>
  import { navigate } from "astro:transitions/client";
  import "virtual:qui/register?components=qui-field,qui-field-label,qui-input,qui-button";

  import { getSharedSession } from "~/auth/client/session";
  import { confirmEnrollment, startEnrollment } from "~/auth/client/two-factor";
  import { readFormValue } from "~/shared/client/form-controls";
  import { clientLogger } from "~/shared/client/logger";

  /** Same-origin redirect target, defaulting to the admin home. */
  function redirectTarget(root: HTMLElement): string {
    const fallback = `${root.dataset.loginHref?.replace(/\/login$/u, "") ?? ""}/admin/`;
    const redirect = new URLSearchParams(globalThis.location.search).get("redirect");

    if (redirect === null) {
      return fallback;
    }

    const target = new URL(redirect, globalThis.location.origin);
    return target.origin === globalThis.location.origin
      ? `${target.pathname}${target.search}`
      : fallback;
  }

  function showNotice(message: string): void {
    const shell = document.querySelector<HTMLElement>("[data-setup-notice]");
    const box = shell?.querySelector<HTMLElement>("[role='alert']");

    if (shell == null || box == null) {
      return;
    }

    box.textContent = message;
    shell.hidden = message.length === 0;
    box.focus();
  }

  function step(root: HTMLElement, name: string): HTMLElement | null {
    return root.querySelector<HTMLElement>(`[data-step='${name}']`);
  }

  function show(root: HTMLElement, name: string): void {
    for (const element of root.querySelectorAll<HTMLElement>("[data-step]")) {
      element.hidden = element.dataset.step !== name;
    }

    showNotice("");
  }

  async function submitPassword(root: HTMLElement, form: HTMLFormElement): Promise<void> {
    const password = readFormValue(form, "password");

    if (password.length === 0) {
      showNotice(root.dataset.required ?? "");
      return;
    }

    const result = await startEnrollment(password);

    if (typeof result === "string") {
      showNotice(result.length > 0 ? result : (root.dataset.failed ?? ""));
      return;
    }

    const qr = root.querySelector<HTMLElement>("[data-qr]");
    const secret = root.querySelector<HTMLElement>("[data-secret]");
    const list = root.querySelector<HTMLElement>("[data-backup-codes]");

    // The encodeQR helper returns trusted SVG markup built from the TOTP URI.
    qr?.setHTMLUnsafe(result.qrSvg);
    secret?.replaceChildren(result.secret);
    list?.replaceChildren(
      ...result.backupCodes.map((code) => {
        const item = document.createElement("li");
        item.textContent = code;
        return item;
      }),
    );
    show(root, "verify");
  }

  async function submitCode(root: HTMLElement, form: HTMLFormElement): Promise<void> {
    const code = readFormValue(form, "code").trim();

    if (code.length === 0) {
      showNotice(root.dataset.required ?? "");
      return;
    }

    const error = await confirmEnrollment(code);

    if (error !== null) {
      showNotice(error.length > 0 ? error : (root.dataset.failed ?? ""));
      return;
    }

    show(root, "backup");
  }

  async function run(root: HTMLElement, task: () => Promise<void>): Promise<void> {
    try {
      await task();
    } catch (error) {
      clientLogger.error(error);
      showNotice(root.dataset.failed ?? "");
    }
  }

  function onSubmit(
    root: HTMLElement,
    form: HTMLElement | null,
    handler: (root: HTMLElement, form: HTMLFormElement) => Promise<void>,
  ): void {
    if (!(form instanceof HTMLFormElement)) {
      return;
    }

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      void run(root, () => handler(root, form));
    });
    form.addEventListener("keydown", (event) => {
      if (event.key === "Enter" && !event.defaultPrevented) {
        event.preventDefault();
        form.requestSubmit();
      }
    });
  }

  async function initSetup(): Promise<void> {
    const root = document.querySelector<HTMLElement>("[data-two-factor-setup]");

    if (root === null || root.dataset.ready === "true") {
      return;
    }

    root.dataset.ready = "true";
    const session = await getSharedSession();

    if (session.data === null) {
      showNotice(root.dataset.signInFirst ?? "");
      step(root, "password")?.setAttribute("hidden", "");
      return;
    }

    onSubmit(root, step(root, "password"), submitPassword);
    onSubmit(root, step(root, "verify"), submitCode);
    root.querySelector("[data-done]")?.addEventListener("click", () => {
      void navigate(redirectTarget(root));
    });
  }

  async function startSetup(): Promise<void> {
    try {
      await initSetup();
    } catch (error) {
      clientLogger.error(error);
    }
  }

  document.addEventListener("astro:page-load", () => {
    void startSetup();
  });
</script>
