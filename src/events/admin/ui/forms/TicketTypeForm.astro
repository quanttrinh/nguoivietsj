---
// @boundary client
import { getBasePlugins, getDictionary } from "@intlayer/core/interpreter";
import type { DeclaredLocales } from "intlayer";

import engineContent from "~/events/content/admin.content";
import { pick } from "~/shared/content/pick";

import { ticketTypeFormLabelKeys } from "./form-labels";
import TicketTypeFormIsland from "./TicketTypeForm.tsx";

interface Props {
  locale: DeclaredLocales;
  mode: "create" | "edit";
}

const { locale, mode }: Props = Astro.props;

const labels = pick(
  getDictionary(engineContent, locale, getBasePlugins(locale)),
  ticketTypeFormLabelKeys,
);
---

<TicketTypeFormIsland client:load mode={mode} locale={locale} labels={labels} />
