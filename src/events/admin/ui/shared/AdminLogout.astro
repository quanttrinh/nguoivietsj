---
// @boundary client
import { adminCatalogUrl } from "~/events/admin/ui/shared/routes";
import { localized as all } from "~/generated/client/all";
import type { Locale } from "~/shared/i18n";
import LogoutButton from "~/shared/ui/LogoutButton.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = all(locale);
---

<LogoutButton
  label={content.engineAdmin.logout}
  loginLabel={content.engineAdmin.login}
  loginUrl={`/${locale}/login`}
  fallbackUrl={adminCatalogUrl(locale)}
/>
