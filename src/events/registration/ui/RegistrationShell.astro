---
// @boundary client
import { getBasePlugins, getDictionary } from "@intlayer/core/interpreter";
import { useDictionary, useLocale } from "astro-intlayer";
import { TURNSTILE_SITE_KEY } from "astro:env/client";

import engineRegistrationContent from "~/events/content/registration.content";
import { REGISTRATION_TURNSTILE_ACTION } from "~/events/domain/registration";
import PublicRegistration from "~/events/registration/ui/PublicRegistration";
import BaseLayout from "~/layouts/BaseLayout.astro";

interface Props {
  preview?: boolean;
  staff?: boolean;
}

const { preview = false, staff = false }: Props = Astro.props;

const { locale } = useLocale();
const content = useDictionary(engineRegistrationContent, locale);

const config = {
  locale,
  turnstile: {
    siteKey: TURNSTILE_SITE_KEY.trim(),
    action: REGISTRATION_TURNSTILE_ACTION,
  },
  labels: getDictionary(engineRegistrationContent, locale, getBasePlugins(locale)),
};
---

<BaseLayout
  title={content.meta.title.value}
  description={content.meta.description.value}
  noindex={preview || staff}
>
  <PublicRegistration client:load config={config} preview={preview} staff={staff} />
</BaseLayout>
