---
// @boundary client
import { TURNSTILE_SITE_KEY } from "astro:env/client";

import { REGISTRATION_TURNSTILE_ACTION } from "~/events/domain/registration";
import PublicRegistration from "~/events/registration/ui/PublicRegistration";
import { localized as all } from "~/generated/client/all";
import { localized as registrationLocalized } from "~/generated/client/PublicRegistration";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { useLocale } from "~/shared/i18n";

interface Props {
  preview?: boolean;
  staff?: boolean;
}

const { preview = false, staff = false }: Props = Astro.props;

const { locale } = useLocale(Astro.url);
const content = all(locale);

const config = {
  locale,
  turnstile: {
    siteKey: TURNSTILE_SITE_KEY.trim(),
    action: REGISTRATION_TURNSTILE_ACTION,
  },
  labels: registrationLocalized(locale),
};
---

<BaseLayout
  title={content.engineRegistration.meta.title}
  description={content.engineRegistration.meta.description}
  noindex={preview || staff}
>
  <PublicRegistration client:load config={config} preview={preview} staff={staff} />
</BaseLayout>
