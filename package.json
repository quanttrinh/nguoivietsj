{
  "name": "nguoivietsj",
  "version": "2.0.0",
  "private": true,
  "description": "Community events and registration platform hosted on Cloudflare Workers",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/quanttrinh/nguoivietsj.git"
  },
  "type": "module",
  "imports": {
    "#tooling/*": "./src/platform/jobs/tooling/*.ts"
  },
  "scripts": {
    "dev": "doppler run -- astro dev",
    "preview": "doppler run -- astro preview",
    "prepreview": "doppler run -- astro build --mode preview",
    "check": "astro sync && tsc -b tsconfig.json && astro check",
    "ark:check": "ark check src",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "codegen": "node --input-type=module -e 'import { i18nConfig } from \"./i18n.config.ts\"; import { generateI18n } from \"./plugins/i18n.ts\"; await generateI18n(i18nConfig)' && panda codegen && node node_modules/wrangler/bin/wrangler.js types src/types/worker-configuration.d.ts",
    "postinstall": "yarn codegen",
    "doppler:setup": "doppler setup",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrations:events": "drizzle-kit generate --config=drizzle.events.config.ts",
    "db:migrations:app": "drizzle-kit generate --config=drizzle.app.config.ts",
    "auth:schema": "auth generate --config ./better-auth.config.ts --dialect sqlite --output ./src/platform/server/db/app/schemas/auth-schema.ts -y && oxfmt src/platform/server/db/app/schemas/auth-schema.ts",
    "db:migrate": "node --import ./scripts/register-node.ts manage.ts migrate",
    "db:seed": "node --import ./scripts/register-node.ts manage.ts seed",
    "db:check": "node --import ./scripts/register-node.ts manage.ts check",
    "test:coverage": "vitest run --project unit --project integration --coverage"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.9",
    "@astrojs/preact": "6.1.6",
    "@better-auth/drizzle-adapter": "1.7.27",
    "@hono/standard-validator": "0.4.1",
    "@nanostores/preact": "1.1.1",
    "@nanostores/query": "0.3.4",
    "@quanttrinh/qui": "0.9.3",
    "arktype": "3.0.0-rc.9",
    "astro": "7.4.13",
    "auth": "1.7.27",
    "better-auth": "1.7.27",
    "drizzle-orm": "1.0.0-rc.6",
    "effect": "4.1.4",
    "hono": "4.13.19",
    "jose": "6.2.18",
    "nanostores": "1.5.5",
    "preact": "11.2.0",
    "qr": "0.7.2",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@ark/aot": "3.0.0-rc.9",
    "@astrojs/check": "0.9.12",
    "@astrojs/compiler-rs": "0.5.3",
    "@cloudflare/workers-types": "5.20261120.1",
    "@fast-check/vitest": "0.5.0",
    "@pandacss/dev": "2.6.0",
    "@pandacss/eslint-plugin": "2.6.0",
    "@pandacss/preset-base": "2.6.0",
    "@pandacss/preset-panda": "2.6.0",
    "@pandacss/vite": "2.6.0",
    "@quanttrinh/qui-unplugin": "0.4.2",
    "@types/node": "26.6.6",
    "@vitest/browser": "5.1.1",
    "@vitest/browser-playwright": "5.1.1",
    "@vitest/coverage-v8": "5.1.1",
    "drizzle-kit": "1.0.0-rc.6",
    "fast-check": "4.10.3",
    "miniflare": "4.20260730.0",
    "oxc-parser": "0.159.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "parse5": "8.1.1",
    "playwright": "1.65.1",
    "typescript": "6.0.3",
    "vitest": "5.1.1",
    "vitest-browser-preact": "2.0.0",
    "wrangler": "4.168.0"
  },
  "resolutions": {
    "fast-check": "4.10.3"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "yarn@6.0.0-rc.23"
}
