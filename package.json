{
  "name": "nguoivietsj",
  "version": "2.0.0",
  "private": true,
  "description": "Community events and registration platform hosted on Cloudflare Workers",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "predev": "intlayer build",
    "build": "astro build",
    "prebuild": "intlayer build",
    "preview": "astro preview",
    "prepreview": "bun run build",
    "deploy": "bun run build && wrangler deploy",
    "dev:staging": "CLOUDFLARE_ENV=staging bun run dev",
    "build:staging": "CLOUDFLARE_ENV=staging bun run build",
    "deploy:staging": "bun run build:staging && wrangler deploy",
    "check": "astro check",
    "precheck": "intlayer build",
    "typecheck": "astro check && oxlint && oxfmt --check",
    "pretypecheck": "intlayer build --check-types",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "panda codegen",
    "postinstall": "wrangler types",
    "cf-typegen": "wrangler types",
    "cf:sync": "python3 scripts/sync_cloudflare_config.py",
    "cf:sync:check": "python3 scripts/sync_cloudflare_config.py --check",
    "test": "bun test",
    "db:generate": "drizzle-kit generate --config=drizzle.events.config.ts",
    "db:generate:custom": "drizzle-kit generate --custom --config=drizzle.events.config.ts",
    "db:generate:app": "drizzle-kit generate --config=drizzle.app.config.ts",
    "db:generate:app:custom": "drizzle-kit generate --custom --config=drizzle.app.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply EVENT_ENGINE_DB --local",
    "db:migrate:app:local": "wrangler d1 migrations apply APP_DB --local"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.3",
    "@astrojs/preact": "6.1.1",
    "@intlayer/core": "^9.7.0",
    "@quanttrinh/qui": "^0.5.0",
    "@sinclair/typebox": "^0.34.52",
    "@zxing/browser": "^0.2.1",
    "astro": "^7.4.4",
    "astro-intlayer": "^9.7.0",
    "drizzle-orm": "0.45.4",
    "effect": "4.1.2",
    "intlayer": "^9.7.0",
    "jose": "^6.2.15",
    "preact": "11.1.1",
    "qr": "^0.7.2",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/compiler-rs": "^0.5.2",
    "@cloudflare/workers-types": "^5.20261102.1",
    "@pandacss/dev": "^2.4.0",
    "@pandacss/preset-base": "^2.4.0",
    "@pandacss/preset-panda": "^2.4.0",
    "@pandacss/vite": "^2.4.0",
    "@quanttrinh/qui-unplugin": "^0.2.0",
    "@types/node": "^26.6.6",
    "drizzle-kit": "0.31.11",
    "es-module-lexer": "^3.0.4",
    "jsonc-parser": "^3.3.1",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "parse5": "^8.1.0",
    "typescript": "6.0.3",
    "wrangler": "^4.156.1"
  },
  "packageManager": "bun@1.4.4"
}
