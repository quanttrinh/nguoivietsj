# GitHub Packages token with read:packages, required by `bun install`.
# Create one with: gh auth refresh -h github.com -s read:packages
NODE_AUTH_TOKEN=gho_replace_me

# Development-only admin identity. The user must exist in local D1.
# Production/staging admin authentication uses Cloudflare Access.
DEV_STAFF_EMAIL=admin@example.com

# Cloudflare Turnstile server secret for local development only.
# The public site key and Turnstile URLs live in `wrangler.jsonc` vars.
# In production, set the secret with `wrangler secret put TURNSTILE_SECRET`.
# This is Cloudflare's always-pass test secret.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

MAILTRAP_API_URL=https://send.api.mailtrap.io/api/send
MAILTRAP_API_TOKEN=
MAILTRAP_FROM_EMAIL=events@nguoivietsj.ca
MAILTRAP_FROM_NAME=Người Việt SJ Events

# Mailtrap-hosted template UUIDs. The app sends template variables only.
MAILTRAP_REGISTRATION_TEMPLATE_UUID=
MAILTRAP_PAYMENT_TEMPLATE_UUID=
MAILTRAP_STATUS_OTP_TEMPLATE_UUID=
