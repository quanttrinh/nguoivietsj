{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nguoivietsj",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "cache": {
    "enabled": false
  },
  "routes": [
    {
      "pattern": "nguoivietsj.ca",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  },
  "queues": {
    "producers": [
      {
        "binding": "EMAIL_QUEUE",
        "queue": "nguoivietsj-emails"
      }
    ],
    "consumers": [
      {
        "queue": "nguoivietsj-emails",
        "max_batch_size": 3,
        "max_batch_timeout": 5,
        "max_concurrency": 1,
        "max_retries": 3,
        "dead_letter_queue": "nguoivietsj-emails-dlq"
      },
      {
        "queue": "nguoivietsj-emails-dlq",
        "max_batch_size": 3,
        "max_batch_timeout": 5,
        "max_retries": 1
      }
    ]
  },
  "secrets": {
    "required": [
      "TURNSTILE_SECRET",
      "GMAIL_CLIENT_ID",
      "GMAIL_CLIENT_SECRET",
      "GMAIL_REFRESH_TOKEN",
      "BETTER_AUTH_SECRET"
    ]
  },
  "vars": {
    "TURNSTILE_SCRIPT_URL": "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit",
    "TURNSTILE_SITEVERIFY_URL": "https://challenges.cloudflare.com/turnstile/v0/siteverify",
    "EMAIL_PROVIDER": "gmail",
    "GMAIL_SENDER_EMAIL": "events@nguoivietsj.ca",
    "GMAIL_SENDER_NAME": "Ng\u01b0\u1eddi Vi\u1ec7t SJ Events",
    "GMAIL_TOKEN_URL": "https://oauth2.googleapis.com/token",
    "GMAIL_SEND_URL": "https://gmail.googleapis.com/gmail/v1/users/me/messages/send",
    "MAILTRAP_API_URL": "",
    "MAILTRAP_FROM_EMAIL": "",
    "MAILTRAP_FROM_NAME": ""
  },
  "ratelimits": [
    {
      "name": "EVENT_ENGINE_REGISTRATION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "EVENT_ENGINE_STATUS_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "AUTH_SEND_OTP_RATE_LIMITER",
      "namespace_id": "1005",
      "simple": {
        "limit": 3,
        "period": 60
      }
    },
    {
      "name": "AUTH_VERIFY_OTP_RATE_LIMITER",
      "namespace_id": "1006",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "APP_DB",
      "database_name": "nguoivietsj-db",
      "migrations_dir": "drizzle/app",
      "migrations_pattern": "drizzle/app/*/migration.sql"
    },
    {
      "binding": "EVENT_ENGINE_DB",
      "database_name": "nguoivietsj-event-engine-db",
      "migrations_dir": "drizzle/events",
      "migrations_pattern": "drizzle/events/*/migration.sql"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "AUTH_SESSION_KV"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.2,
    "issues": {
      "enabled": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.2,
      "persist": true
    }
  },
  "env": {
    "staging": {
      "name": "nguoivietsj-staging",
      "routes": [
        {
          "pattern": "staging.nguoivietsj.ca",
          "custom_domain": true
        }
      ],
      "workers_dev": false,
      "preview_urls": false,
      "triggers": {
        "crons": [
          "0 3 * * *"
        ]
      },
      "vars": {
        "TURNSTILE_SCRIPT_URL": "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit",
        "TURNSTILE_SITEVERIFY_URL": "https://challenges.cloudflare.com/turnstile/v0/siteverify",
        "EMAIL_PROVIDER": "gmail",
        "GMAIL_SENDER_EMAIL": "events@nguoivietsj.ca",
        "GMAIL_SENDER_NAME": "Ng\u01b0\u1eddi Vi\u1ec7t SJ Events",
        "GMAIL_TOKEN_URL": "https://oauth2.googleapis.com/token",
        "GMAIL_SEND_URL": "https://gmail.googleapis.com/gmail/v1/users/me/messages/send",
        "MAILTRAP_API_URL": "",
        "MAILTRAP_FROM_EMAIL": "",
        "MAILTRAP_FROM_NAME": ""
      },
      "secrets": {
        "required": [
          "TURNSTILE_SECRET",
          "GMAIL_CLIENT_ID",
          "GMAIL_CLIENT_SECRET",
          "GMAIL_REFRESH_TOKEN",
          "BETTER_AUTH_SECRET"
        ]
      },
      "ratelimits": [
        {
          "name": "EVENT_ENGINE_REGISTRATION_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": {
            "limit": 10,
            "period": 60
          }
        },
        {
          "name": "EVENT_ENGINE_STATUS_RATE_LIMITER",
          "namespace_id": "1004",
          "simple": {
            "limit": 5,
            "period": 60
          }
        },
        {
          "name": "AUTH_SEND_OTP_RATE_LIMITER",
          "namespace_id": "1007",
          "simple": {
            "limit": 3,
            "period": 60
          }
        },
        {
          "name": "AUTH_VERIFY_OTP_RATE_LIMITER",
          "namespace_id": "1008",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "EMAIL_QUEUE",
            "queue": "nguoivietsj-staging-emails"
          }
        ],
        "consumers": [
          {
            "queue": "nguoivietsj-staging-emails",
            "max_batch_size": 3,
            "max_batch_timeout": 5,
            "max_concurrency": 1,
            "max_retries": 3,
            "dead_letter_queue": "nguoivietsj-staging-emails-dlq"
          },
          {
            "queue": "nguoivietsj-staging-emails-dlq",
            "max_batch_size": 3,
            "max_batch_timeout": 5,
            "max_retries": 1
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "APP_DB",
          "database_name": "nguoivietsj-staging-db",
          "migrations_dir": "drizzle/app",
          "migrations_pattern": "drizzle/app/*/migration.sql"
        },
        {
          "binding": "EVENT_ENGINE_DB",
          "database_name": "nguoivietsj-staging-event-engine-db",
          "migrations_dir": "drizzle/events",
          "migrations_pattern": "drizzle/events/*/migration.sql"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "AUTH_SESSION_KV"
        }
      ],
      "observability": {
        "enabled": true,
        "head_sampling_rate": 0.2,
        "issues": {
          "enabled": true
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 0.2,
          "persist": true
        }
      }
    }
  }
}
