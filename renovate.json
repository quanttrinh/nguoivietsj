{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "github>aquaproj/aqua-renovate-config#2.15.0"],
  "timezone": "America/Moncton",
  "schedule": ["before 6am on monday"],
  "dependencyDashboard": {
    "enabled": true
  },
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "Keep the Terraform required version unpinned.",
      "matchManagers": ["terraform"],
      "matchDepNames": ["hashicorp/terraform"],
      "enabled": false
    },
    {
      "description": "Group one-time range-to-pin updates.",
      "groupName": "Pin dependencies",
      "matchUpdateTypes": ["pin"]
    },
    {
      "description": "Group Bun updates across package.json and aqua.",
      "groupName": "Bun",
      "matchPackageNames": ["bun", "oven-sh/bun"]
    },
    {
      "description": "Group Astro updates.",
      "groupName": "Astro",
      "matchPackageNames": ["/^astro$/", "/^@astrojs\\//"]
    },
    {
      "description": "Group Intlayer updates.",
      "groupName": "Intlayer",
      "matchPackageNames": ["/^intlayer$/", "/^@intlayer\\//", "/^astro-intlayer$/"]
    },
    {
      "description": "Group Panda CSS updates.",
      "groupName": "Panda CSS",
      "matchPackageNames": ["/^@pandacss\\//"]
    },
    {
      "description": "Group Drizzle updates.",
      "groupName": "Drizzle",
      "matchPackageNames": ["/^drizzle-/"]
    },
    {
      "description": "Group Better Auth updates.",
      "groupName": "Better Auth",
      "matchPackageNames": ["/^better-auth$/", "/^@better-auth\\//", "/^auth$/"]
    },
    {
      "description": "Group Qui component-library updates.",
      "groupName": "Qui",
      "matchPackageNames": ["/^@quanttrinh\\//"]
    },
    {
      "description": "Group lint and format tooling.",
      "groupName": "Lint and format",
      "matchPackageNames": ["/^oxc-/", "/^oxfmt$/", "/^oxlint$/", "/^oxlint-/"]
    },
    {
      "description": "Auto-merge patch updates to development dependencies.",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Pin GitHub Actions to commit SHAs.",
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "rangeStrategy": "replace"
    },
    {
      "description": "Do not pin the aqua version input as an action digest.",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["aqua"],
      "pinDigests": false
    },
    {
      "description": "Do not pin aqua itself as an action digest.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["aquaproj/aqua"],
      "pinDigests": false
    },
    {
      "description": "Auto-merge minor and patch updates to GitHub Actions.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Major updates require dashboard approval.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "hostRules": [
    {
      "matchHost": "https://npm.pkg.github.com/",
      "hostType": "npm",
      "token": "{{ secrets.QUI_PACKAGES_TOKEN }}"
    }
  ],
  "npmrc": "@quanttrinh:registry=https://npm.pkg.github.com/",
  "rangeStrategy": "pin"
}
