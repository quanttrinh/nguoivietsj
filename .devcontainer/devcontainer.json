{
  "name": "nguoivietsj",
  "build": {
    "dockerfile": "Containerfile",
    "context": ".."
  },
  "secrets": {
    "NODE_AUTH_TOKEN": {
      "description": "GitHub token with read:packages, used to install @quanttrinh/qui from GitHub Packages."
    }
  },
  "postCreateCommand": "bun install --frozen-lockfile",
  "forwardPorts": [4321],
  "portsAttributes": {
    "4321": {
      "label": "Astro dev server",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["astro-build.astro-vscode", "oven.bun-vscode", "oxc.oxc-vscode"],
      "settings": {
        "editor.codeActionsOnSave": {
          "source.fixAll.oxc": "always"
        },
        "editor.defaultFormatter": "oxc.oxc-vscode",
        "editor.formatOnSave": true,
        "terminal.integrated.defaultProfile.linux": "zsh",
        "js/ts.tsdk.path": "node_modules/typescript/lib"
      }
    }
  }
}
