# syntax=docker/dockerfile:1

FROM debian:trixie-slim

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    SHELL=/bin/zsh

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
   ssh \
   git \
   zsh \
   curl \
   unzip \
   ca-certificates \
   passwd \
   ncurses-base \
   ncurses-bin \
   ncurses-term \
 && rm -rf /var/lib/apt/lists/*

RUN sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended \
 && usermod --shell "$(command -v zsh)" root

# Pinned, checksum-verified Node/npm and Bun. Keep the pins in
# scripts/tools/*.env so version bumps do not edit this file.
COPY scripts /tmp/build-scripts
RUN bash /tmp/build-scripts/install-node.sh \
 && bash /tmp/build-scripts/install-bun.sh \
 && rm -rf /tmp/build-scripts

CMD ["/bin/zsh"]
