{
  "extends": ["astro/tsconfigs/strictest", "./tsconfig.paths.json"],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./.astro/tsconfig/server",
    "tsBuildInfoFile": "./.astro/tsconfig/server.tsbuildinfo",
    "types": ["node"],
    "lib": ["ESNext"]
  },
  "include": [
    ".astro/types.d.ts",
    ".astro/env.d.ts",
    "src/types/**/*.d.ts",
    "better-auth.config.ts",
    "i18n.config.ts",
    "manage.ts",
    "plugins/**/*.ts",
    "scripts/**/*.ts",
    "src/*.ts",
    "src/features/auth/**/*.ts",
    "src/features/events/content/**/*.ts",
    "src/features/events/domain/**/*.ts",
    "src/features/events/server/**/*.ts",
    "src/features/events/server/services/**/*.ts",
    "src/generated/**/*.ts",
    "src/features/shell/home/content/**/*.ts",
    "src/features/shell/layouts/**/*.ts",
    "src/features/shell/login/content/**/*.ts",
    "src/platform/**/*.ts"
  ],
  "exclude": ["dist", "src/**/ui/**", "src/platform/client/**", "src/features/auth/client/**"]
}
