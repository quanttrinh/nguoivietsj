{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./.astro/tsconfig/server",
    "tsBuildInfoFile": "./.astro/tsconfig/server.tsbuildinfo",
    "types": ["@cloudflare/workers-types", "node"],
    "paths": {
      "~/*": ["./src/*"],
      "styled-system/*": ["./styled-system/*"]
    },
    "lib": ["ESNext"]
  },
  "include": [
    ".intlayer/**/*.ts",
    ".astro/types.d.ts",
    "package.json",
    "worker-configuration.d.ts",
    "plugins/**/*.ts",
    "src/**/*.ts",
    "src/**/*.astro"
  ],
  "exclude": ["src/**/islands/**", "src/shared/client/**", "dist", "node_modules", "styled-system"],
  "references": [
    {
      "path": "./tsconfig.client.json"
    }
  ]
}
